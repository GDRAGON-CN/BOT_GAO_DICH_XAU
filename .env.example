# Environment Runtime Mode
# APP_ENV: Runtime stage ['local', 'production'] (Required, default: local)
APP_ENV=local
# DEBUG: Verbose debug logging boolean [true, false] (Required, default: true)
DEBUG=true
# TRADING_ENV: Trading environment ['DEMO', 'LIVE'] (Required, default: DEMO - Never live by default)
TRADING_ENV=DEMO

# Server Network Configuration
# SERVER_HOST: Internal IP to bind FastAPI (Required, default: 127.0.0.1)
SERVER_HOST=127.0.0.1
# SERVER_PORT: Port number to bind FastAPI (Required, default: 8000)
SERVER_PORT=8000
# CORS_ORIGINS: JSON list of permitted frontend origins (Required)
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Database Configuration (MySQL 8+)
# DB_HOST: Private MySQL host address (Required, must remain 127.0.0.1)
DB_HOST=127.0.0.1
# DB_PORT: MySQL server port (Required, default: 3306)
DB_PORT=3306
# DB_USER: Dedicated MySQL user for application (Required)
DB_USER=tradebot_user
# DB_PASSWORD: Password for DB_USER (Required, provide strong password)
DB_PASSWORD=YOUR_SECURE_MYSQL_PASSWORD
# DB_NAME: Database schema name (Required, default: tradebot_db)
DB_NAME=tradebot_db

# MetaTrader 5 Broker Configuration
# MT5_PATH: Optional path to terminal64.exe (Optional, leave empty for auto-detect)
MT5_PATH=
# MT5_LOGIN: MT5 Account Login Number (Required. Set 0 to activate in-memory MockBroker simulator)
MT5_LOGIN=0
# MT5_PASSWORD: MT5 Trader account password (Required if MT5_LOGIN > 0)
MT5_PASSWORD=YOUR_DEMO_PASSWORD
# MT5_SERVER: Broker server name (Required, default: VantageInternational-Demo)
MT5_SERVER=VantageInternational-Demo
# MT5_TIMEOUT_MS: Execution and query timeout in milliseconds (Required, default: 10000)
MT5_TIMEOUT_MS=10000

# Symbol Configuration (Externalized)
# DEFAULT_SYMBOL: Base instrument for execution (Required, default: XAUUSD)
DEFAULT_SYMBOL=XAUUSD
# BROKER_SYMBOL_MAP: JSON dictionary mapping TradingView symbol to broker symbol (Required)
BROKER_SYMBOL_MAP={"XAUUSD":"XAUUSD"}

# Security Tokens
# WEBHOOK_SECRET: Secret passphrase required in TradingView payload / header (Required)
WEBHOOK_SECRET=tv_sec_supersecretkey_change_me_9988
# DASHBOARD_API_KEY: Secret key required for Dashboard control commands (Required)
DASHBOARD_API_KEY=dash_key_change_me_supersecret_1234

# Risk Engine Thresholds
# RISK_PERCENT_PER_TRADE: Default capital risk percentage per trade (Required, default: 1.0)
RISK_PERCENT_PER_TRADE=1.0
# MAX_RISK_PERCENT_PER_TRADE: Hard backend ceiling; webhook payload cannot exceed this (Required, default: 2.0)
MAX_RISK_PERCENT_PER_TRADE=2.0
# MAX_DAILY_LOSS_PERCENT: Circuit breaker daily drawdown cap percentage (Required, default: 3.0)
MAX_DAILY_LOSS_PERCENT=3.0
# INCLUDE_FLOATING_LOSS_IN_DAILY_LOSS: Include floating unrealized drawdown in circuit breaker (Required, default: true)
INCLUDE_FLOATING_LOSS_IN_DAILY_LOSS=true
# MAX_OPEN_POSITIONS: Maximum concurrent open positions (Required, default: 2)
MAX_OPEN_POSITIONS=2
# MAX_LOT_SIZE: Hard ceiling on order lots (Required, default: 1.00)
MAX_LOT_SIZE=1.00
# MIN_LOT_SIZE: Minimum permissible order lots (Required, default: 0.01)
MIN_LOT_SIZE=0.01
# MAX_SPREAD_POINTS: Maximum allowed spread in points before rejecting signal (Required, default: 35.0)
MAX_SPREAD_POINTS=35.0
# MAX_SLIPPAGE_POINTS: Execution slippage tolerance in points (Required, default: 20.0)
MAX_SLIPPAGE_POINTS=20.0
# MAX_CONSECUTIVE_LOSSES: Maximum consecutive loss count before pausing (Required, default: 3)
MAX_CONSECUTIVE_LOSSES=3
# COOLDOWN_MINUTES_AFTER_LOSS: Duration to pause trading after hitting loss limit (Required, default: 30)
COOLDOWN_MINUTES_AFTER_LOSS=30
# ALLOW_TRADING_SESSIONS: JSON list of allowable sessions (Required, default: ["LONDON","NEW_YORK","ASIAN"])
ALLOW_TRADING_SESSIONS=["LONDON","NEW_YORK","ASIAN"]

# Webhook Safety & Ingestion
# ALERT_TIMESTAMP_TOLERANCE_SECONDS: Maximum allowed clock drift for alerts in seconds (Required, default: 300)
ALERT_TIMESTAMP_TOLERANCE_SECONDS=300

# Telegram Notifications
# TELEGRAM_ENABLE_ALERTS: Enable or disable Telegram notifications (Required, default: false)
TELEGRAM_ENABLE_ALERTS=false
# TELEGRAM_BOT_TOKEN: Telegram Bot API Token from @BotFather (Required if TELEGRAM_ENABLE_ALERTS=true)
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRstuVWXyz
# TELEGRAM_CHAT_ID: Telegram destination chat or group ID (Required if TELEGRAM_ENABLE_ALERTS=true)
TELEGRAM_CHAT_ID=-1001234567890
